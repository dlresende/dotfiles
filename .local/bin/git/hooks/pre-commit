#!/usr/bin/env bash

# Pre-commit hook to enforce allowed email addresses
# Configure allowed emails in the ALLOWED_EMAILS variable below
# (space-separated for multiple)

: "${GIT_AUTHOR_EMAIL:=$(git config user.email)}"

ALLOWED_EMAILS="$PERSONAL_EMAIL"

ALLOWED=false
for email in $ALLOWED_EMAILS; do
  if [ "$GIT_AUTHOR_EMAIL" = "$email" ]; then
    ALLOWED=true
    break
  fi
done

if [ "$ALLOWED" = false ]; then
  echo "ERROR: Commit rejected!"
  echo "Your email ($GIT_AUTHOR_EMAIL) is not in the allowed list."
  echo "Allowed emails: $ALLOWED_EMAILS"
  exit 1
fi
