#!/usr/bin/env bash

: "${DEBUG:=}"
: "${HOMEBREW_BUNDLE_FILE_GLOBAL:=$HOME/.Brewfile}"

set -e # bail out early if any command fails
set -u # fail if we hit unset variables
set -o pipefail # fail if any component of any pipe fails

[[ -z "$DEBUG" ]] || set -x

main() {
  switch_to_bash
  install_stuff
  install_ruby && check_rbenv
  configure_vim
  configure_tmux
  configure_git
}

switch_to_bash() {
  [ "$SHELL" = '/bin/bash' ] || chsh -s /bin/bash
}

install_stuff() {
  local noise_level

  if [ -z "$DEBUG" ]
  then
    noise_level='--quiet'
  else
    noise_level='--debug'
  fi

  if [ -x /opt/homebrew/bin/brew ]
  then
    # Already installed on disk - `command -v brew` below would still say
    # "not found" here if this script wasn't launched from a shell that
    # sourced .exports, and re-running the installer against an existing
    # Homebrew is exactly what triggers the sudo failure noted below.
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif ! command -v 'brew' &> /dev/null
  then
    # The installer's NONINTERACTIVE sudo check uses `sudo -n`, which never
    # prompts - without an already-cached ticket it fails immediately even
    # for a genuine admin. Establish the ticket ourselves first.
    sudo -v

    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # The installer only prints instructions to add itself to PATH - it
    # never touches the running shell - so `brew` is still not found in
    # this same script run without doing it ourselves.
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi

  brew bundle check --global 2> /dev/null || brew bundle install --global --upgrade "$noise_level"
  # brew bundle --upgrade only upgrades formulas, not casks
  # Run brew upgrade separately to upgrade casks as well
  brew upgrade "$noise_level"

  log_tool_versions
}

log_tool_versions() {
  local log_file_suffix
  log_file_suffix=$(date +%Y%m%d-%H%M%S)

  local log_dir
  log_dir="${HOME}/.local/log"
  mkdir -p "$log_dir" 

  local log_file
  log_file="${log_dir}/pimp.$log_file_suffix"

  # brew list --versions ignores casks unless told to, so a combined
  # --formula --casks list makes it fail on every cask name.
  {
    brew bundle list --formula --global | xargs brew list --versions --formula
    brew bundle list --casks --global | xargs brew list --versions --cask
  } > "${log_file}"
}

install_ruby() {
  rbenv install --skip-existing "$(rbenv install -l | grep -v - | tail -1)"
}

check_rbenv() {
  curl -fsSL https://github.com/rbenv/rbenv-installer/raw/main/bin/rbenv-doctor | bash
}

configure_vim() {
  curl -fsSL https://vimfiles.diegolemos.net/install | bash
}

configure_tmux() {
  TMUX_PLUGIN_MANAGER_PATH="$HOME/.tmux/plugins"

  echo "Updating tmux plugins..."
  if [[ ! -d "$TMUX_PLUGIN_MANAGER_PATH/tpm" ]] ; then
    mkdir -p "$TMUX_PLUGIN_MANAGER_PATH"
    git clone https://github.com/tmux-plugins/tpm "$TMUX_PLUGIN_MANAGER_PATH/tpm"
    "$TMUX_PLUGIN_MANAGER_PATH"/tpm/bin/install_plugins
  else
    ( cd "$TMUX_PLUGIN_MANAGER_PATH/tpm" && git pull )
    "$TMUX_PLUGIN_MANAGER_PATH"/tpm/bin/update_plugins all
  fi
}

configure_go_workspace() {
  if [[ -L "$HOME"/go/src && -d "$HOME"/go/src ]]
  then
    echo "Go workspace already configured. Moving on."
    return
  fi

  mv "$HOME"/go/src/* "$HOME"/Projects
  rm -fr "$HOME"/go/src
  ln -s "$HOME"/Projects "$HOME"/go/src
}

configure_git() {
  ln -sf "${HOME}/.local/bin/git/hooks/pre-commit" "${HOME}/.git/hooks"
}

main
