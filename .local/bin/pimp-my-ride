#!/usr/bin/env bash

: "${DEBUG:=}"
: "${HOMEBREW_BUNDLE_FILE_GLOBAL:=$HOME/.Brewfile}"
: "${OS:=$(uname -s)}"

case "$OS" in
  Darwin) : "${HOMEBREW_PREFIX:=/opt/homebrew}" ;;
  Linux)  : "${HOMEBREW_PREFIX:=/home/linuxbrew/.linuxbrew}" ;;
  *)      : "${HOMEBREW_PREFIX:=}" ;;
esac
export HOMEBREW_PREFIX

# So `command -v brew` finds an existing install regardless of whether this
# script was launched from a shell that sourced .exports. Appending, not
# prepending, means this can never outrank .bashrc's own ordering (rbenv
# shims ahead of Homebrew's bin) - safe to always run, no guard needed.
[ -n "$HOMEBREW_PREFIX" ] && export PATH="$PATH:$HOMEBREW_PREFIX/bin"

set -e # bail out early if any command fails
set -u # fail if we hit unset variables
set -o pipefail # fail if any component of any pipe fails

[[ -z "$DEBUG" ]] || set -x

main() {
  case "$OS" in
    Darwin) accept_xcode_license ;;
  esac
  switch_to_bash
  install_stuff
  install_ruby && check_rbenv
  configure_vim
  configure_tmux
  configure_git
  case "$OS" in
    Linux)
      configure_ubuntu
      ;;
  esac
}

refresh_admin_credentials() {
  # Primes a sudo ticket so later sudo calls in this run - Homebrew's own
  # NONINTERACTIVE installer checks access with `sudo -n`, which never
  # prompts, and Linux's apt/systemd steps need sudo too - don't have to
  # prompt again.
  sudo -v
}

accept_xcode_license() {
  refresh_admin_credentials

  # A Command Line Tools update can silently reset the active developer
  # directory back to itself even after Xcode is installed - xcodebuild
  # then refuses to run at all. Skipped on a fresh machine where Xcode
  # isn't installed yet; CLT alone is enough for xcodebuild's own license
  # prompt in that case.
  [ -d /Applications/Xcode.app ] && sudo xcode-select -s /Applications/Xcode.app

  sudo xcodebuild -license accept
}

switch_to_bash() {
  # CI runners are ephemeral and don't need a login-shell change - and
  # chsh needs a real password prompt (PAM) it can never satisfy here.
  [ -n "${CI:-}" ] && return

  local bash_path="$HOMEBREW_PREFIX/bin/bash"

  # The OS-provided bash (Apple's ancient 3.2, kept frozen for GPL licensing
  # reasons; distros' own default shell otherwise) has job-control bugs that
  # misbehave under tmux - spurious "child setpgid: Operation not permitted"
  # warnings on every piped command.
  if ! grep -qxF "$bash_path" /etc/shells
  then
    refresh_admin_credentials
    echo "$bash_path" | sudo tee -a /etc/shells > /dev/null
  fi

  [ "$SHELL" = "$bash_path" ] || chsh -s "$bash_path"
}

install_stuff() {
  local noise_level

  if [ -z "$DEBUG" ]
  then
    noise_level='--quiet'
  else
    noise_level='--debug'
  fi
  
  case "$OS" in
    Linux)
      sudo apt-get update

      # Install Homebrew dependencies
      # https://docs.brew.sh/Homebrew-on-Linux#requirements
      sudo apt-get install --yes \
        build-essential \
        procps \
        curl \
        file \
        git

      # Install Flatpak so we can manage more app installations from Homebrew
      # https://flatpak.org/setup/Ubuntu
      sudo apt-get install --yes \
        flatpak \
        gnome-software-plugin-flatpak

      sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
      ;;
  esac

  ensure_homebrew_installed

  brew bundle check --global 2> /dev/null || brew bundle install --global --upgrade "$noise_level"
  # brew bundle --upgrade skips casks; brew upgrade covers them too
  brew upgrade "$noise_level"

  log_tool_versions
}

ensure_homebrew_installed() {
  # .bashrc (sourced by install/CI before this script runs) already puts
  # HOMEBREW_PREFIX/bin on PATH regardless of whether brew exists there yet,
  # so it's immediately resolvable the moment the installer below finishes -
  # no need to re-derive the environment from `brew shellenv` afterwards.
  command -v brew &> /dev/null && return

  refresh_admin_credentials
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

log_tool_versions() {
  local log_file_suffix
  log_file_suffix=$(date +%Y%m%d-%H%M%S)

  local log_dir
  log_dir="${HOME}/.local/log"
  mkdir -p "$log_dir" 

  local log_file
  log_file="${log_dir}/pimp.$log_file_suffix"

  # brew list --versions ignores casks unless told which type to list
  {
    brew bundle list --formula --global | xargs brew list --versions --formula
    brew bundle list --casks --global | xargs brew list --versions --cask
  } > "${log_file}"
}

install_ruby() {
  # Link against Homebrew's zlib (installed by install_stuff above) rather
  # than a stale system one, when present.
  case "$OS" in
    Linux)
      [ -d "$HOMEBREW_PREFIX/opt/zlib" ] && export RUBY_CONFIGURE_OPTS="--with-zlib-dir=$HOMEBREW_PREFIX/opt/zlib"
      ;;
  esac

  rbenv install --skip-existing "$(rbenv install -l | grep -v - | tail -1)"
}

check_rbenv() {
  curl -fsSL https://github.com/rbenv/rbenv-installer/raw/main/bin/rbenv-doctor | bash
}

configure_vim() {
  curl -fsSL https://vimfiles.diegolemos.net/install | bash
}

configure_tmux() {
  TMUX_PLUGIN_MANAGER_PATH="$HOME/.tmux/plugins"

  echo "Updating tmux plugins..."
  if [[ ! -d "$TMUX_PLUGIN_MANAGER_PATH/tpm" ]] ; then
    mkdir -p "$TMUX_PLUGIN_MANAGER_PATH"
    git clone https://github.com/tmux-plugins/tpm "$TMUX_PLUGIN_MANAGER_PATH/tpm"
    "$TMUX_PLUGIN_MANAGER_PATH"/tpm/bin/install_plugins
  else
    ( cd "$TMUX_PLUGIN_MANAGER_PATH/tpm" && git pull )
    "$TMUX_PLUGIN_MANAGER_PATH"/tpm/bin/update_plugins all
  fi
}

configure_go_workspace() {
  if [[ -L "$HOME"/go/src && -d "$HOME"/go/src ]]
  then
    echo "Go workspace already configured. Moving on."
    return
  fi

  mv "$HOME"/go/src/* "$HOME"/Projects
  rm -fr "$HOME"/go/src
  ln -s "$HOME"/Projects "$HOME"/go/src
}

configure_git() {
  ln -sf "${HOME}/.local/bin/git/hooks/pre-commit" "${HOME}/.git/hooks"
}

configure_ubuntu() {
  local conf="${HOME}/.local/etc/systemd/do-nothing-when-lid-is-closed-on-external-power-supply.conf"

  if [ ! -f "$conf" ]
  then
    echo "configure_ubuntu: missing $conf" >&2
    return 1
  fi

  sudo mkdir -p /etc/systemd/logind.conf.d/
  sudo cp "$conf" /etc/systemd/logind.conf.d/
}

main
