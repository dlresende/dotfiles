#!/usr/bin/env bash

: "${OS:=$(uname -s)}"
: "${1:?PID is required}"

select_stdout() {
  sed -u -E -n '/^(\[[^]]+\]|[0-9]+)?[[:space:]]*write\(1,/p'
}

extract_payload() {
  sed -u -E 's/^(\[[^]]+\]|[0-9]+)?[[:space:]]*write\(1,[[:space:]]*"(.*)"(\.\.\.)?,[[:space:]]*[0-9]+\)[[:space:]]*=[[:space:]]*[0-9]+$/\2/'
}

normalize_escapes() {
  sed -u -E 's/\\([0-9]{1,3})/\\0\1/g; s/\\(["'\''?%])/\1/g'
}

render_payload() {
  while IFS= read -r line
  do
    printf '%b' "$line"
  done
}

case "$OS" in
  Darwin)
    sudo dtrace -p "$1" -qn '
        syscall::write*:entry
        /pid == $target && arg0 == 1/ {
            printf("%s", copyinstr(arg1, arg2));
        }
    '
    ;;
  Linux)
    if ! command -v strace &> /dev/null
    then
      >&2 echo 'capture-process-stdout: requires strace on Linux'
      exit 1
    fi

    sudo strace -p "$1" -s 65536 -f -e trace=write -o /dev/stdout -q -e quiet=all \
      | select_stdout \
      | extract_payload \
      | normalize_escapes \
      | render_payload
    ;;
  *)
    >&2 echo "capture-process-stdout: unsupported operating system: $OS"
    exit 1
    ;;
esac
