# Consult `git config --help` for details about the options

[aliases]
  lol = log --graph --decorate --pretty=oneline --abbrev-commit
  lola = log --graph --decorate --pretty=oneline --abbrev-commit --all

[color]
  ui = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  frag = magenta bold # line info
  meta = yellow bold
  new = green # additions
  old = red # deletions

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[core]
  editor = vim
  excludesfile = ~/.gitignore_global
  whitespace = space-before-tab,-indent-with-non-tab,trailing-space

[pull]
  rebase = true

[credential "https://github.com"]
  helper = # resets any helper set by lower-priority config
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper = # resets any helper set by lower-priority config
  helper = !gh auth git-credential

# Anything machine-specific or not for public consumption (work hosts, commit
# template, identity) lives here. Git ignores the include if the file is
# missing, so a fresh checkout still works.
[include]
  path = ~/.gitconfig.local
