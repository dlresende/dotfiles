# Ignore everything by default (repo root is $HOME)
*

# Explicitly re-allow tracked files and their directory trees
!.Brewfile
!.XCompose
!.aliases
!.bash_profile
!.bashrc
!.completions
!.exports
!.functions
!.gemrc
!.gitconfig

!.github
.github/*
!.github/workflows
.github/workflows/*
!.github/workflows/install.yml
!.github/workflows/publish-image.yml

!.gitignore

!.local
.local/*
!.local/bin
.local/bin/*
!.local/bin/capture_process_stdout
!.local/bin/firefox
!.local/bin/git
.local/bin/git/*
!.local/bin/git/hooks
.local/bin/git/hooks/*
!.local/bin/git/hooks/pre-commit
!.local/bin/git-duet
!.local/bin/git-duet-commit
!.local/bin/git-solo
!.local/bin/install.sh
!.local/bin/pimp-my-ride
!.local/etc
.local/etc/*
!.local/etc/macos
.local/etc/macos/*
!.local/etc/macos/com.apple.symbolichotkeys.plist
!.local/etc/systemd
.local/etc/systemd/*
!.local/etc/systemd/do-nothing-when-lid-is-closed-on-external-power-supply.conf

!.path
!.tigrc
!.tmux.conf
!CNAME
!README.md
!_config.yml

# Re-deny sensitive paths, local agent metadata, git repository internals, and secrets
.git
.agents
.claude
Dockerfile
.dockerignore
board.yml
**/.git
**/.ssh
**/.aws
**/.gnupg
**/.config
**/.netrc
**/.npmrc
**/.docker
**/.kube
**/.gitconfig.local
**/.git-authors
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*credentials*
